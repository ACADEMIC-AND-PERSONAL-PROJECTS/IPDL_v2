# .env.example — SénSanté Pro
# Copier ce fichier vers .env et renseigner les valeurs avant de lancer docker compose.

# ── Base de données PostgreSQL ──
POSTGRES_DB=sensante_pro
POSTGRES_USER=sensante_user
POSTGRES_PASSWORD=CHANGER_CE_MOT_DE_PASSE

# ── JWT — clé de signature (minimum 256 bits) ──
# Générer avec : openssl rand -base64 32
JWT_SECRET=CHANGER_CETTE_CLE_MINIMUM_256_BITS

# ── DeepSeek API (utilisée comme backend IA, compatible OpenAI) ──
ANTHROPIC_AUTH_TOKEN=sk-VOTRE_CLE_DEEPSEEK

# ── Frontend — URL de l'API ──
# Laisser vide pour que le frontend utilise des URLs relatives (/api/…).
# Le proxy nginx du conteneur frontend redirige ensuite vers le backend.
# En développement local avec Vite, laisser vide aussi (le proxy Vite gère).
VITE_API_URL=